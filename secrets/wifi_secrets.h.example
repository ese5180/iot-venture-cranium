/*
 * Wi-Fi credentials used to provision a development board.
 *
 * Run `python tools/secrets.py wifi` to create ~/.cranium/wifi_secrets.h in this
 * format: it asks for the values (the passphrase is not echoed) and writes the file
 * owned by root with mode 600, so that reading it needs an administrator password.
 *
 * wifi_secrets.h is deliberately NOT compiled into the firmware. A passphrase built
 * into the image would be present in every OTA image stored in the cloud and in the
 * external flash of every device. Instead, tools/provision_device.py sends the values
 * to the board over the serial console once, and the board keeps them in TF-M's
 * trusted storage, where they survive firmware updates.
 */
#ifndef WIFI_SECRETS_H_
#define WIFI_SECRETS_H_

/* Network name, 1 to 32 bytes. */
#define WIFI_SECRETS_SSID "your-network-name"

/* Passphrase, 8 to 63 characters for WPA2-PSK and WPA3-SAE. */
#define WIFI_SECRETS_PASSPHRASE "your-passphrase"

/*
 * One of WPA2_PSK, WPA2_PSK_SHA256 or WPA3_SAE.
 * Open, WEP and WPA (TKIP) networks are refused by the firmware.
 */
#define WIFI_SECRETS_SECURITY WPA2_PSK

#endif /* WIFI_SECRETS_H_ */
